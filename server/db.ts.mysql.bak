import { and, desc, eq, sql } from "drizzle-orm";
import { drizzle } from "drizzle-orm/mysql2";
import { collaterals, customerProfiles, documents, loanApplications, loans, payments, InsertUser, users } from "../drizzle/schema";
import { ENV } from "./_core/env";

let _db: ReturnType<typeof drizzle> | null = null;

export async function getDb() {
  if (!_db && process.env.DATABASE_URL) {
    try { _db = drizzle(process.env.DATABASE_URL); } catch (error) { console.warn("[Database] Failed to connect:", error); _db = null; }
  }
  return _db;
}

export async function upsertUser(user: InsertUser): Promise<void> {
  if (!user.openId) throw new Error("User openId is required for upsert");
  const db = await getDb();
  if (!db) return;
  const values: InsertUser = { openId: user.openId };
  const updateSet: Record<string, unknown> = {};
  const textFields = ["name", "email", "loginMethod"] as const;
  textFields.forEach((field) => { if (user[field] !== undefined) { values[field] = user[field] ?? null; updateSet[field] = user[field] ?? null; } });
  if (user.lastSignedIn !== undefined) { values.lastSignedIn = user.lastSignedIn; updateSet.lastSignedIn = user.lastSignedIn; }
  if (user.role !== undefined) { values.role = user.role; updateSet.role = user.role; }
  else if (user.openId === ENV.ownerOpenId) { values.role = "admin"; updateSet.role = "admin"; }
  if (!values.lastSignedIn) values.lastSignedIn = new Date();
  if (!Object.keys(updateSet).length) updateSet.lastSignedIn = new Date();
  await db.insert(users).values(values).onDuplicateKeyUpdate({ set: updateSet });
}

export async function getUserByOpenId(openId: string) {
  const db = await getDb(); if (!db) return undefined;
  const result = await db.select().from(users).where(eq(users.openId, openId)).limit(1);
  return result[0];
}

export async function createLoanApplication(input: typeof loanApplications.$inferInsert) {
  const db = await getDb();
  if (!db) return { id: 0, ...input };
  const result = await db.insert(loanApplications).values(input);
  return { id: Number(result[0].insertId), applicationNumber: input.applicationNumber };
}

export async function listLoanApplications() {
  const db = await getDb(); if (!db) return [];
  return db.select().from(loanApplications).orderBy(desc(loanApplications.createdAt));
}

export async function updateLoanApplicationStatus(id: number, status: "under_review" | "approved" | "rejected" | "documents_required", adminNote?: string) {
  const db = await getDb(); if (!db) return { id, status, adminNote };
  await db.update(loanApplications).set({ status, adminNote: adminNote || null }).where(eq(loanApplications.id, id));
  if (status === "approved") {
    const application = await db.select().from(loanApplications).where(eq(loanApplications.id, id)).limit(1);
    const row = application[0];
    if (row && row.userId) {
      const existingLoan = await db.select().from(loans).where(eq(loans.applicationId, id)).limit(1);
      if (!existingLoan.length) {
        const principal = row.requiredAmount;
        const term = row.preferredDuration || 12;
        const installment = Math.ceil(principal / term);
        await db.insert(loans).values({ applicationId: id, userId: row.userId, loanNumber: `CXS-${new Date().getFullYear()}-${String(id).padStart(5, "0")}`, loanType: row.loanType, principalAmount: principal, interestRate: 6, termMonths: term, repaymentFrequency: row.repaymentFrequency, installmentAmount: installment, outstanding: principal, status: "approved", approvedAt: new Date(), nextDueDate: new Date(Date.now() + 30 * 86400000) });
      }
    }
  }
  return { id, status, adminNote };
}

export async function getAdminSummary() {
  const db = await getDb();
  if (!db) return { summary: { totalApplications: 0, activeLoans: 0, outstanding: 0, collection: 0 }, distribution: [], trend: [], applications: [] };
  const [applicationsCount] = await db.select({ count: sql<number>`count(*)` }).from(loanApplications);
  const [activeLoansCount] = await db.select({ count: sql<number>`count(*)` }).from(loans).where(sql`${loans.status} in ('approved','disbursed','active','overdue')`);
  const [outstandingSum] = await db.select({ total: sql<number>`coalesce(sum(${loans.outstanding}), 0)` }).from(loans);
  const [collectionSum] = await db.select({ total: sql<number>`coalesce(sum(${payments.amount}), 0)` }).from(payments).where(sql`month(${payments.paidAt}) = month(current_date()) and year(${payments.paidAt}) = year(current_date())`);
  const distribution = await db.select({ name: loanApplications.loanType, value: sql<number>`count(*)` }).from(loanApplications).groupBy(loanApplications.loanType);
  const allPayments = await db.select({ amount: payments.amount, paidAt: payments.paidAt }).from(payments).orderBy(desc(payments.paidAt)).limit(60);
  const trendMap = new Map<string, number>();
  allPayments.forEach((payment) => { const key = new Date(payment.paidAt).toLocaleDateString("en-IN", { month: "short" }); trendMap.set(key, (trendMap.get(key) || 0) + Number(payment.amount || 0)); });
  const trend = Array.from(trendMap.entries()).reverse().map(([month, amount]) => ({ month, amount }));
  return { summary: { totalApplications: Number(applicationsCount?.count || 0), activeLoans: Number(activeLoansCount?.count || 0), outstanding: Number(outstandingSum?.total || 0), collection: Number(collectionSum?.total || 0) }, distribution, trend, applications: await listLoanApplications() };
}

export async function getAdminCollectionData() {
  const db = await getDb(); if (!db) return [];
  return db.select().from(payments).orderBy(desc(payments.paidAt)).limit(100);
}

export async function getAdminLoans() {
  const db = await getDb(); if (!db) return [];
  return db.select().from(loans).orderBy(desc(loans.createdAt));
}

export async function getAdminCustomers() {
  const db = await getDb(); if (!db) return [];
  return db.select({ id: users.id, name: users.name, email: users.email, role: users.role, createdAt: users.createdAt, phone: customerProfiles.phone, occupation: customerProfiles.occupation, monthlyIncome: customerProfiles.monthlyIncome }).from(users).leftJoin(customerProfiles, eq(users.id, customerProfiles.userId)).orderBy(desc(users.createdAt));
}

export async function getAdminCollateral() {
  const db = await getDb(); if (!db) return [];
  return db.select().from(collaterals).orderBy(desc(collaterals.createdAt));
}

export async function getAdminDocuments() {
  const db = await getDb(); if (!db) return [];
  return db.select().from(documents).orderBy(desc(documents.createdAt));
}

export async function getCustomerDashboard(userId: number) {
  const db = await getDb(); if (!db) return { loan: null, totalPaid: 0, schedule: [] };
  const loanRows = await db.select().from(loans).where(eq(loans.userId, userId)).orderBy(desc(loans.createdAt)).limit(1);
  const loan = loanRows[0];
  if (!loan) return { loan: null, totalPaid: 0, schedule: [] };
  const paidRows = await db.select().from(payments).where(and(eq(payments.userId, userId), eq(payments.loanId, loan.id))).orderBy(desc(payments.paidAt));
  const totalPaid = paidRows.reduce((sum, payment) => sum + Number(payment.amount || 0), 0);
  const schedule = Array.from({ length: Math.min(loan.termMonths || 0, 6) }, (_, index) => ({ installmentNumber: index + 1, dueDate: new Date((loan.nextDueDate || new Date()).getTime() + index * 30 * 86400000), amount: loan.installmentAmount, status: index < paidRows.length ? "paid" : "pending" }));
  return { loan: { ...loan, nextDueAmount: loan.installmentAmount }, totalPaid, schedule };
}

export async function getCustomerLoan(userId: number) {
  const db = await getDb(); if (!db) return null;
  const rows = await db.select().from(loans).where(eq(loans.userId, userId)).orderBy(desc(loans.createdAt)).limit(1);
  const loan = rows[0]; if (!loan) return null;
  const paymentRows = await db.select().from(payments).where(and(eq(payments.loanId, loan.id), eq(payments.userId, userId)));
  const installmentsPaid = paymentRows.length;
  const totalInstallments = loan.termMonths || 0;
  return { ...loan, nextDueAmount: loan.installmentAmount, installmentsPaid, totalInstallments, progress: totalInstallments ? Math.round((installmentsPaid / totalInstallments) * 100) : 0 };
}

export async function getCustomerPayments(userId: number) {
  const db = await getDb(); if (!db) return [];
  return db.select().from(payments).where(eq(payments.userId, userId)).orderBy(desc(payments.paidAt));
}

export async function getCustomerDocuments(userId: number) {
  const db = await getDb(); if (!db) return [];
  return db.select().from(documents).where(eq(documents.userId, userId)).orderBy(desc(documents.createdAt));
}

export async function getCustomerProfile(userId: number) {
  const db = await getDb(); if (!db) return null;
  const rows = await db.select({ name: users.name, email: users.email, phone: customerProfiles.phone, address: customerProfiles.address, occupation: customerProfiles.occupation, monthlyIncome: customerProfiles.monthlyIncome }).from(users).leftJoin(customerProfiles, eq(users.id, customerProfiles.userId)).where(eq(users.id, userId)).limit(1);
  return rows[0] || null;
}

export async function updateCustomerProfile(userId: number, input: { name: string; email: string; phone: string; address: string; occupation: string; monthlyIncome: number }) {
  const db = await getDb(); if (!db) return input;
  await db.update(users).set({ name: input.name, email: input.email }).where(eq(users.id, userId));
  await db.insert(customerProfiles).values({ userId, phone: input.phone, address: input.address, occupation: input.occupation, monthlyIncome: input.monthlyIncome }).onDuplicateKeyUpdate({ set: { phone: input.phone, address: input.address, occupation: input.occupation, monthlyIncome: input.monthlyIncome } });
  return input;
}

export async function addDocument(input: typeof documents.$inferInsert) {
  const db = await getDb(); if (!db) return { id: 0, ...input };
  const result = await db.insert(documents).values(input);
  return { id: Number(result[0].insertId), ...input };
}
